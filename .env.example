# CinemaSeat — environment variables for `docker compose up`.
#
# Copy this file to `.env` and edit the values for your deployment.
# The values here are DEV-ONLY placeholders. Do NOT commit a real
# `.env`; see `.gitignore`.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=cinemaseat
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat

# The backend uses this DSN to reach Postgres. The hostname MUST match
# the docker-compose service name (`db`), not `localhost` — Docker's
# embedded DNS resolves service names inside the compose network.
DATABASE_URL=postgresql+psycopg://cinemaseat:cinemaseat@db:5432/cinemaseat

# ---------------------------------------------------------------------------
# Mock payment gateway
# ---------------------------------------------------------------------------
# Where the backend POSTs /charge. Service name `gateway`, NOT localhost.
# The upstream mock-gateway image listens on container port 9000.
MOCK_GATEWAY_URL=http://gateway:9000
# The URL the gateway POSTs back to. Service name `backend`, NOT localhost.
MOCK_GATEWAY_CALLBACK_URL=http://backend:8000/payments/callback

# Gateway deterministic mode keeps outcomes predictable for the demo.
# Use empty string `""` for chaos/random mode.
MOCK_GATEWAY_MODE=deterministic

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
HOLD_TTL_SECONDS=120
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Vite inlines this URL into the JS bundle at build time. It MUST be
# the browser-visible URL of the mock gateway (port 8080 on the host
# machine), since the SPA in the browser cannot resolve Docker service
# names. Override to https://your-domain if you put TLS in front.
VITE_API_URL=http://localhost:8080
